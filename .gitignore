# =====================================================================
# MORPH MONOREPO ROOT .GITIGNORE (FRONTEND, BACKEND, & MOBILE FLUTTER)
# =====================================================================

# --- Dependencies (Node.js & Flutter/Dart) ---
node_modules/
**/node_modules/
frontend/node_modules/
backend/node_modules/
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
/.pnp
.pnp.*
.yarn/*

# --- Build & Output Directories (Next.js, NestJS, & Flutter) ---
/.next/
**/.next/
/out/
**/out/
/dist/
**/dist/
/build/
**/build/

# --- Environment Files & Secrets ---
.env
.env.local
.env.*
**/.env
**/.env.local
**/.env.*

# --- Vercel & Deployment Cache ---
.vercel/
**/.vercel/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# --- Logs & OS Misc ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
